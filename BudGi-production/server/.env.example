# ── Required ──────────────────────────────────────────────────────────────────
MONGO_URI=mongodb://localhost:27017/budgi
JWT_SECRET=change-this-to-a-random-string-of-at-least-32-characters

# ── Server ────────────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=5000
LOG_LEVEL=debug                   # error | warn | info | http | debug

# ── Auth ──────────────────────────────────────────────────────────────────────
JWT_EXPIRES_IN=7d

# ── CORS (comma-separated for multiple origins) ───────────────────────────────
CLIENT_ORIGIN=http://localhost:5173

# ── Rate limiting (optional — defaults shown) ─────────────────────────────────
RATE_LIMIT_WINDOW_MS=900000        # 15 minutes in ms
RATE_LIMIT_MAX=200                 # general routes
RATE_LIMIT_AUTH_MAX=20             # /api/auth/* (brute-force protection)
RATE_LIMIT_AI_MAX=30               # /api/ai/* (LLM cost protection)
RATE_LIMIT_SMS_MAX=50              # /api/sms/* (SMS parsing)

# ── Optional integrations ─────────────────────────────────────────────────────
GROQ_API_KEY=                      # https://console.groq.com
EXCHANGE_RATE_API_KEY=             # https://www.exchangerate-api.com
ALPHA_VANTAGE_API_KEY=             # https://www.alphavantage.co
REDIS_URL=                         # leave empty to use in-memory cache

# ── Mobile / Android ──────────────────────────────────────────────────────────
ANDROID_PACKAGE_NAME=com.budgi.app
ANDROID_CERT_FINGERPRINTS=         # SHA-256 fingerprints, comma-separated
FIREBASE_SERVICE_ACCOUNT_PATH=     # Absolute path to Firebase service account JSON
