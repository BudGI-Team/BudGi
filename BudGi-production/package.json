{
  "name": "budgi",
  "version": "3.0.0",
  "description": "BudGi — AI-Powered Personal Finance Platform",
  "private": true,
  "scripts": {
    "dev:server": "cd server && node src/server.js",
    "dev:client": "cd client && npx vite",
    "install:all": "cd server && npm install && cd ../client && npm install",
    "start": "cd server && node src/server.js",
    "lint": "npm run lint:server && npm run lint:client",
    "lint:server": "cd server && npx eslint src/",
    "lint:client": "cd client && npx eslint src/ --ext .js,.jsx",
    "format": "npx prettier --write ."
  },
  "devDependencies": {
    "eslint": "^8.57.0",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^4.6.2",
    "prettier": "^3.2.5"
  }
}
